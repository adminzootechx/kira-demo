# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Derived books, both grains. Real LUSTRE account and account-manager names —
# regenerate from the source workbooks with data-samples/sale_data_ingest.py
# rather than committing them.
data-samples/*.csv
data-samples/lustre-periods.json
data-samples/__pycache__/
.playwright-mcp
.gap-cache/
*.log

# Nivoda probe output
nivoda-probe-out/
