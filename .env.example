# Copy to .env.local.
#
# Auth.js session secret — any random string (e.g. `openssl rand -base64 32`).
AUTH_SECRET=
# Needed for `next start` outside Vercel (Vercel and `next dev` set it themselves).
AUTH_TRUST_HOST=true

# Leave DATABASE_URL unset for demo mode: the app runs on data/demo-* with two
# built-in accounts. Set it to a Postgres connection string (e.g. a free Neon
# project), then run `pnpm db:migrate` and `pnpm db:seed`, to turn on the
# database features — targets, approvals, tasks, notes, admin.
DATABASE_URL=

# Optional standby, used automatically while DATABASE_URL is unreachable.
DATABASE_URL_BACKUP=
# Only for a Postgres reached through a WebSocket tunnel: its address and gate key.
DATABASE_WS_PROXY=
DATABASE_WS_KEY=

# Trade data API credentials, for the live sales sync on /data. Optional.
TRADE_API_USERNAME=
TRADE_API_PASSWORD=

# Protects /api/cron/tradeapi-sync from public triggering.
CRON_SECRET=
